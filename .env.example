# Copy to .env.local for `next dev`, and set the same names in Vercel (Production and Preview).
# Never commit real values.

# Zoho CRM (TalentXM org): website forms F-01…F-04 create a Lead. See lib/forms/zoho.ts.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Only if the org is not on the US data centre, e.g. https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL=
# Optional overrides. Defaults: Lead Source "Website Form", Lead Status "New", owner = the Self Client's user.
ZOHO_LEAD_SOURCE=
ZOHO_LEAD_STATUS=
# Zoho user ID of the Lead Owner (Setup > Users > open the user: the number at the end of the URL)
ZOHO_LEAD_OWNER_ID=
